# Variables d'environnement — à configurer dans Vercel

# ─── Authentification des clients ───────────────────────────────
# Une ou plusieurs clés, séparées par des virgules.
# Génère-en une avec : openssl rand -hex 32
API_KEYS=change-moi-en-production

# ─── Jeton du worker (navigateur) ───────────────────────────────
# Ce jeton doit être IDENTIQUE côté API (ici) et côté worker (worker/.env).
WORKER_TOKEN=un-secret-different-de-api-keys

# ─── Persistance (recommandé) ───────────────────────────────────
# Sans ces variables, tout est stocké en mémoire : les données
# disparaissent à chaque redémarrage de la fonction.
# Upstash Redis gratuit : https://upstash.com → Redis → REST API
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Réglages optionnels ────────────────────────────────────────
# Durée d'attente du mode synchrone (ms). Vercel limite la fonction à 30 s.
SYNC_WAIT_MS=25000

# 1 = accepte les requêtes sans clé (à ne PAS activer en production)
ALLOW_ANONYMOUS=0
