# ─────────────────────────────────────────────
#  GLM Agent API — variables à mettre sur Vercel
# ─────────────────────────────────────────────

# Clés d'accès client (une ou plusieurs, séparées par des virgules)
# Génère avec : openssl rand -hex 32
API_KEYS=change-moi-en-production

# Secret partagé avec le worker (doit être identique dans worker/.env)
WORKER_TOKEN=un-secret-different-des-cles-clients

# Persistance (recommandé, gratuit) — https://upstash.com → Redis → REST API
# Sans ces deux variables, tout est en mémoire et disparaît au redémarrage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Durée max d'attente du mode synchrone (ms)
SYNC_WAIT_MS=25000

# 1 = accepte les appels sans clé (NE PAS activer en production)
ALLOW_ANONYMOUS=0
