# Sur la machine qui a un navigateur

# URL de l'API déployée (sans slash final)
API_BASE=https://ton-projet.vercel.app

# Même valeur que WORKER_TOKEN dans Vercel
WORKER_TOKEN=

# 1 = navigateur invisible · 0 = visible
HEADLESS=1

# Attente max d'une réponse GLM (ms)
ANSWER_TIMEOUT_MS=180000

# Fréquence de sondage quand la file est vide (ms)
WORKER_POLL_MS=3000

# 1 = simule (aucun navigateur nécessaire pour tester la chaîne)
DRY_RUN=0
