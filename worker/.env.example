# Variables d'environnement du worker — sur la machine qui a un navigateur

# URL de l'API déployée (sans slash final)
API_BASE=https://ton-projet.vercel.app

# Même valeur que WORKER_TOKEN dans Vercel
WORKER_TOKEN=un-secret-different-de-api-keys

# Dossier du profil Chromium (session chat.z.ai déjà validée)
GLM_PROFILE_DIR=./worker-profile

# 1 = navigateur invisible · 0 = visible (utile pour voir ce qui se passe)
HEADLESS=1

# Fréquence d'interrogation de l'API quand la file est vide (ms)
WORKER_POLL_MS=3000

# 1 = n'ouvre pas de navigateur, simule les réponses (test de la chaîne)
DRY_RUN=0
